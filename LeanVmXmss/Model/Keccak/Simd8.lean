    a2_0 := r.a2_0 ^^^ a2_0, a2_1 := r.a2_1 ^^^ a2_1, a2_2 := r.a2_2 ^^^ a2_2, a2_3 := r.a2_3 ^^^ a2_3,
    a2_4 := r.a2_4 ^^^ a2_4, a2_5 := r.a2_5 ^^^ a2_5, a2_6 := r.a2_6 ^^^ a2_6, a2_7 := r.a2_7 ^^^ a2_7,
    a3_0 := r.a3_0 ^^^ a3_0, a3_1 := r.a3_1 ^^^ a3_1, a3_2 := r.a3_2 ^^^ a3_2, a3_3 := r.a3_3 ^^^ a3_3,
    a3_4 := r.a3_4 ^^^ a3_4, a3_5 := r.a3_5 ^^^ a3_5, a3_6 := r.a3_6 ^^^ a3_6, a3_7 := r.a3_7 ^^^ a3_7,
    a4_0 := r.a4_0 ^^^ a4_0, a4_1 := r.a4_1 ^^^ a4_1, a4_2 := r.a4_2 ^^^ a4_2, a4_3 := r.a4_3 ^^^ a4_3,
    a4_4 := r.a4_4 ^^^ a4_4, a4_5 := r.a4_5 ^^^ a4_5, a4_6 := r.a4_6 ^^^ a4_6, a4_7 := r.a4_7 ^^^ a4_7 }

@[inline] def setRow5FromCols
    (r : Row5x8)
    (a0_0 a0_1 a0_2 a0_3 a0_4 a0_5 a0_6 a0_7
     a1_0 a1_1 a1_2 a1_3 a1_4 a1_5 a1_6 a1_7
     a2_0 a2_1 a2_2 a2_3 a2_4 a2_5 a2_6 a2_7
     a3_0 a3_1 a3_2 a3_3 a3_4 a3_5 a3_6 a3_7
     a4_0 a4_1 a4_2 a4_3 a4_4 a4_5 a4_6 a4_7 : UInt64) : Row5x8 :=
