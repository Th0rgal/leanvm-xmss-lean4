@[inline] def Vec8.bcast (x : UInt64) : Vec8 :=
  ⟨x, x, x, x, x, x, x, x⟩

@[inline] def Vec8.xor (a b : Vec8) : Vec8 :=
  ⟨a.w0 ^^^ b.w0, a.w1 ^^^ b.w1, a.w2 ^^^ b.w2, a.w3 ^^^ b.w3,
   a.w4 ^^^ b.w4, a.w5 ^^^ b.w5, a.w6 ^^^ b.w6, a.w7 ^^^ b.w7⟩

/-- One Keccak row (`y ∈ 0..4`) across 8 SIMD lanes: 5 columns × 8 lanes = 40 unboxed `UInt64`s. -/
structure Row5x8 where
  a0_0 : UInt64
  a0_1 : UInt64
  a0_2 : UInt64
  a0_3 : UInt64
  a0_4 : UInt64
  a0_5 : UInt64
  a0_6 : UInt64
  a0_7 : UInt64
