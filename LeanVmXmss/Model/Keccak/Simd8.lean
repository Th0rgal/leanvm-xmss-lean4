  { dst with
    a0_0 := (dst.a0_0 ^^^ dst.a0_0) ^^^ src.a0_0, a0_1 := src.a0_1, a0_2 := src.a0_2, a0_3 := src.a0_3, a0_4 := src.a0_4, a0_5 := src.a0_5, a0_6 := src.a0_6, a0_7 := src.a0_7,
    a1_0 := src.a1_0, a1_1 := src.a1_1, a1_2 := src.a1_2, a1_3 := src.a1_3, a1_4 := src.a1_4, a1_5 := src.a1_5, a1_6 := src.a1_6, a1_7 := src.a1_7,
    a2_0 := src.a2_0, a2_1 := src.a2_1, a2_2 := src.a2_2, a2_3 := src.a2_3, a2_4 := src.a2_4, a2_5 := src.a2_5, a2_6 := src.a2_6, a2_7 := src.a2_7,
