  { r with
    a0_0 := r.a0_0 ^^^ a0_0, a0_1 := r.a0_1 ^^^ a0_1, a0_2 := r.a0_2 ^^^ a0_2, a0_3 := r.a0_3 ^^^ a0_3,
    a0_4 := r.a0_4 ^^^ a0_4, a0_5 := r.a0_5 ^^^ a0_5, a0_6 := r.a0_6 ^^^ a0_6, a0_7 := r.a0_7 ^^^ a0_7,
