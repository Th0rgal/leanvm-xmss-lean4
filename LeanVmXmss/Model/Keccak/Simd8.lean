  let b := stepWs8 b 0x8000000000000080
  let b := stepWs8 b 0x800a
  let b := stepWs8 b 0x800000008000000a
  let b := stepWs8 b 0x8000000080008081
  let b := stepWs8 b 0x8000000000008080
  let b := stepWs8 b 0x80000001
  stepWs8 b 0x8000000080008008

/-- Pure wrapper for 8-lane Keccak-f[1600] on `State25x8`. -/
def keccakF1600x8 (st : State25x8) : State25x8 :=
  let ws := permuteWs8 (loadStateIntoWs st (mkKeccakWs8 0))
  ⟨ws.r0, ws.r1, ws.r2, ws.r3, ws.r4⟩

/-- Eight 32-byte digests produced simultaneously by one 8-lane Keccak operation. -/
structure Digests8 where
  d0 : Digest32
  d1 : Digest32
  d2 : Digest32
  d3 : Digest32
  d4 : Digest32
  d5 : Digest32
  d6 : Digest32
  d7 : Digest32
  deriving Inhabited

@[inline] def extractDigestsWs8 (ws : KeccakWs8) : Digests8 :=
  let r0 := ws.r0
  ⟨⟨r0.a0_0, r0.a1_0, r0.a2_0, r0.a3_0⟩,
   ⟨r0.a0_1, r0.a1_1, r0.a2_1, r0.a3_1⟩,
   ⟨r0.a0_2, r0.a1_2, r0.a2_2, r0.a3_2⟩,
   ⟨r0.a0_3, r0.a1_3, r0.a2_3, r0.a3_3⟩,
   ⟨r0.a0_4, r0.a1_4, r0.a2_4, r0.a3_4⟩,
   ⟨r0.a0_5, r0.a1_5, r0.a2_5, r0.a3_5⟩,
   ⟨r0.a0_6, r0.a1_6, r0.a2_6, r0.a3_6⟩,
   ⟨r0.a0_7, r0.a1_7, r0.a2_7, r0.a3_7⟩⟩

@[inline] def absorbWords17Ws8
    (ws : KeccakWs8)
    (w00 w01 w02 w03 w04 w05 w06 w07 w08 w09 w10 w11 w12 w13 w14 w15 w16 : Vec8) : KeccakWs8 :=
  let z : Vec8 := default
  let ws :=
    { ws with
      r0 := xorRow5WithVecs ws.r0 w00 w01 w02 w03 w04,
      r1 := xorRow5WithVecs ws.r1 w05 w06 w07 w08 w09,
      r2 := xorRow5WithVecs ws.r2 w10 w11 w12 w13 w14,
      r3 := xorRow5WithVecs ws.r3 w15 w16 z z z }
  permuteWs8 ws

@[inline] def absorbFinal13Ws8
    (ws : KeccakWs8)
    (w00 w01 w02 w03 w04 w05 w06 w07 w08 w09 w10 w11 w12 : Vec8) : KeccakWs8 :=
  let z : Vec8 := default
  let pad1 := Vec8.bcast 1
  let padTop := Vec8.bcast 0x8000000000000000
  let ws :=
    { ws with
      r0 := xorRow5WithVecs ws.r0 w00 w01 w02 w03 w04,
      r1 := xorRow5WithVecs ws.r1 w05 w06 w07 w08 w09,
      r2 := xorRow5WithVecs ws.r2 w10 w11 w12 pad1 z,
      r3 := xorRow5WithVecs ws.r3 z padTop z z z }
  permuteWs8 ws

structure Transposed8x8 where
  c0 : Vec8
  c1 : Vec8
  c2 : Vec8
  c3 : Vec8
  c4 : Vec8
  c5 : Vec8
  c6 : Vec8
  c7 : Vec8
  deriving Inhabited

@[inline] def transpose8x8 (v0 v1 v2 v3 v4 v5 v6 v7 : Vec8) : Transposed8x8 :=
  ⟨⟨v0.w0, v1.w0, v2.w0, v3.w0, v4.w0, v5.w0, v6.w0, v7.w0⟩,
   ⟨v0.w1, v1.w1, v2.w1, v3.w1, v4.w1, v5.w1, v6.w1, v7.w1⟩,
   ⟨v0.w2, v1.w2, v2.w2, v3.w2, v4.w2, v5.w2, v6.w2, v7.w2⟩,
   ⟨v0.w3, v1.w3, v2.w3, v3.w3, v4.w3, v5.w3, v6.w3, v7.w3⟩,
   ⟨v0.w4, v1.w4, v2.w4, v3.w4, v4.w4, v5.w4, v6.w4, v7.w4⟩,
   ⟨v0.w5, v1.w5, v2.w5, v3.w5, v4.w5, v5.w5, v6.w5, v7.w5⟩,
   ⟨v0.w6, v1.w6, v2.w6, v3.w6, v4.w6, v5.w6, v6.w6, v7.w6⟩,
   ⟨v0.w7, v1.w7, v2.w7, v3.w7, v4.w7, v5.w7, v6.w7, v7.w7⟩⟩

@[inline] def getColumnBlock8 (buf : Array Vec8) (nVecs baseRow colVec : Nat) : Transposed8x8 :=
  let z : Vec8 := default
  let b0 := baseRow * nVecs + colVec
  let b1 := b0 + nVecs
  let b2 := b1 + nVecs
  let b3 := b2 + nVecs
  let b4 := b3 + nVecs
  let b5 := b4 + nVecs
  let b6 := b5 + nVecs
  let b7 := b6 + nVecs
  transpose8x8
    (buf.getD b0 z) (buf.getD b1 z) (buf.getD b2 z) (buf.getD b3 z)
    (buf.getD b4 z) (buf.getD b5 z) (buf.getD b6 z) (buf.getD b7 z)

@[inline] def zeroBlock8 : Transposed8x8 :=
  let z : Vec8 := default
  ⟨z, z, z, z, z, z, z, z⟩

/-- Hash 8 consecutive rows starting at `baseRow` in `buf` (`nVecs` `Vec8`s per row, `1 ≤ nVecs ≤ 8`),
    mutating `ws : KeccakWs8` in place and returning both `(Digests8, ws)`. -/
def hash8LeavesVec8Ws (st1 st2 st3 : @& State25x8) (ws : KeccakWs8) (buf : @& Array Vec8) (nVecs baseRow : Nat)
    : Digests8 × KeccakWs8 :=
  let zb := zeroBlock8
  let (t0, t1, t2, t3, t4, t5, t6, t7) :=
    match nVecs with
    | 0 => (zb, zb, zb, zb, zb, zb, zb, zb)
    | 1 => (zb, zb, zb, zb, zb, zb, zb, getColumnBlock8 buf 1 baseRow 0)
    | 2 => (zb, zb, zb, zb, zb, zb, getColumnBlock8 buf 2 baseRow 0, getColumnBlock8 buf 2 baseRow 1)
    | 3 =>
      (zb, zb, zb, zb, zb,
       getColumnBlock8 buf 3 baseRow 0, getColumnBlock8 buf 3 baseRow 1, getColumnBlock8 buf 3 baseRow 2)
    | 4 =>
      (zb, zb, zb, zb,
       getColumnBlock8 buf 4 baseRow 0, getColumnBlock8 buf 4 baseRow 1,
       getColumnBlock8 buf 4 baseRow 2, getColumnBlock8 buf 4 baseRow 3)
    | 5 =>
      (zb, zb, zb,
       getColumnBlock8 buf 5 baseRow 0, getColumnBlock8 buf 5 baseRow 1, getColumnBlock8 buf 5 baseRow 2,
       getColumnBlock8 buf 5 baseRow 3, getColumnBlock8 buf 5 baseRow 4)
    | 6 =>
      (zb, zb,
       getColumnBlock8 buf 6 baseRow 0, getColumnBlock8 buf 6 baseRow 1, getColumnBlock8 buf 6 baseRow 2,
       getColumnBlock8 buf 6 baseRow 3, getColumnBlock8 buf 6 baseRow 4, getColumnBlock8 buf 6 baseRow 5)
    | 7 =>
      (zb,
       getColumnBlock8 buf 7 baseRow 0, getColumnBlock8 buf 7 baseRow 1, getColumnBlock8 buf 7 baseRow 2,
       getColumnBlock8 buf 7 baseRow 3, getColumnBlock8 buf 7 baseRow 4,
       getColumnBlock8 buf 7 baseRow 5, getColumnBlock8 buf 7 baseRow 6)
    | _ =>
      (getColumnBlock8 buf nVecs baseRow 0, getColumnBlock8 buf nVecs baseRow 1,
       getColumnBlock8 buf nVecs baseRow 2, getColumnBlock8 buf nVecs baseRow 3,
       getColumnBlock8 buf nVecs baseRow 4, getColumnBlock8 buf nVecs baseRow 5,
       getColumnBlock8 buf nVecs baseRow 6, getColumnBlock8 buf nVecs baseRow 7)
  let ws :=
    if nVecs ≤ 5 then
      if nVecs ≤ 3 then
        if nVecs ≤ 1 then loadStateIntoWs st3 ws
        else loadStateIntoWs st2 ws
      else loadStateIntoWs st1 ws
    else
      absorbWords17Ws8 (zeroWs8 ws)
        t0.c0 t0.c1 t0.c2 t0.c3 t0.c4 t0.c5 t0.c6 t0.c7
        t1.c0 t1.c1 t1.c2 t1.c3 t1.c4 t1.c5 t1.c6 t1.c7 t2.c0
  let ws :=
    if nVecs ≤ 3 then ws
    else
      absorbWords17Ws8 ws
        t2.c1 t2.c2 t2.c3 t2.c4 t2.c5 t2.c6 t2.c7
        t3.c0 t3.c1 t3.c2 t3.c3 t3.c4 t3.c5 t3.c6 t3.c7
        t4.c0 t4.c1
  let ws :=
    if nVecs ≤ 1 then ws
    else
      absorbWords17Ws8 ws
        t4.c2 t4.c3 t4.c4 t4.c5 t4.c6 t4.c7
        t5.c0 t5.c1 t5.c2 t5.c3 t5.c4 t5.c5 t5.c6 t5.c7
        t6.c0 t6.c1 t6.c2
  let ws :=
    absorbFinal13Ws8 ws
      t6.c3 t6.c4 t6.c5 t6.c6 t6.c7
      t7.c0 t7.c1 t7.c2 t7.c3 t7.c4 t7.c5 t7.c6 t7.c7
  (extractDigestsWs8 ws, ws)

@[inline] def hash8LeavesVec8From (st1 st2 st3 : State25x8) (buf : Array Vec8) (nVecs baseRow : Nat) : Digests8 :=
  (hash8LeavesVec8Ws st1 st2 st3 (mkKeccakWs8 0) buf nVecs baseRow).1

@[inline] def xorRow5FromCols
    (r : Row5x8)
    (a0_0 a0_1 a0_2 a0_3 a0_4 a0_5 a0_6 a0_7
     a1_0 a1_1 a1_2 a1_3 a1_4 a1_5 a1_6 a1_7
     a2_0 a2_1 a2_2 a2_3 a2_4 a2_5 a2_6 a2_7
