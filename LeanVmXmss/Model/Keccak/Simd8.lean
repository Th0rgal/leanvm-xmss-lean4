        v0_2.w4 v1_2.w4 v2_2.w4 v3_2.w4 v4_2.w4 v5_2.w4 v6_2.w4 v7_2.w4
        v0_2.w5 v1_2.w5 v2_2.w5 v3_2.w5 v4_2.w5 v5_2.w5 v6_2.w5 v7_2.w5
        v0_2.w6 v1_2.w6 v2_2.w6 v3_2.w6 v4_2.w6 v5_2.w6 v6_2.w6 v7_2.w6
        v0_2.w7 v1_2.w7 v2_2.w7 v3_2.w7 v4_2.w7 v5_2.w7 v6_2.w7 v7_2.w7,
      r3 := xorRow5FromCols ws.r3
        v0_3.w0 v1_3.w0 v2_3.w0 v3_3.w0 v4_3.w0 v5_3.w0 v6_3.w0 v7_3.w0
        v0_3.w1 v1_3.w1 v2_3.w1 v3_3.w1 v4_3.w1 v5_3.w1 v6_3.w1 v7_3.w1
        0 0 0 0 0 0 0 0
