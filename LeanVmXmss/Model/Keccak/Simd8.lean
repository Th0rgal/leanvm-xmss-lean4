  a4_3 : UInt64
  a4_4 : UInt64
  a4_5 : UInt64
  a4_6 : UInt64
  a4_7 : UInt64
  deriving Inhabited

/-- Five rows (`a00..a24`) across 8 SIMD lanes. -/
structure State25x8 where
  r0 : Row5x8
  r1 : Row5x8
  r2 : Row5x8
  r3 : Row5x8
  r4 : Row5x8
  deriving Inhabited

/-- Reusable zero-allocation 8-lane Keccak workspace: active rows `r0..r4`, double-buffer rows `w0..w4`, and `scr`. -/
structure KeccakWs8 where
  r0 : Row5x8
  r1 : Row5x8
  r2 : Row5x8
  r3 : Row5x8
  r4 : Row5x8
  w0 : Row5x8
  w1 : Row5x8
  w2 : Row5x8
  w3 : Row5x8
  w4 : Row5x8
  scr : Row5x8
  deriving Inhabited

@[noinline] def mkFreshRow5x8 (seed : UInt64) : Row5x8 :=
  { (default : Row5x8) with a0_0 := seed ^^^ seed }

/-- Allocate a fresh, exclusively-owned `KeccakWs8` workspace per worker task so every
    subsequent `Row5x8` and `KeccakWs8` update mutates in-place (`rc == 1`, zero heap allocs). -/
@[noinline] def mkKeccakWs8 (seed : Nat := 0) : KeccakWs8 :=
  let s := UInt64.ofNat seed
  ⟨mkFreshRow5x8 s, mkFreshRow5x8 (s + 1), mkFreshRow5x8 (s + 2), mkFreshRow5x8 (s + 3), mkFreshRow5x8 (s + 4),
   mkFreshRow5x8 (s + 5), mkFreshRow5x8 (s + 6), mkFreshRow5x8 (s + 7), mkFreshRow5x8 (s + 8), mkFreshRow5x8 (s + 9),
   mkFreshRow5x8 (s + 10)⟩

@[inline] def mkRow5FromVecs (c0 c1 c2 c3 c4 : @& Vec8) (out : Row5x8) : Row5x8 :=
  let z := out.a0_0 ^^^ out.a0_0
  { out with
    a0_0 := z ^^^ c0.w0, a0_1 := c0.w1, a0_2 := c0.w2, a0_3 := c0.w3, a0_4 := c0.w4, a0_5 := c0.w5, a0_6 := c0.w6, a0_7 := c0.w7,
    a1_0 := c1.w0, a1_1 := c1.w1, a1_2 := c1.w2, a1_3 := c1.w3, a1_4 := c1.w4, a1_5 := c1.w5, a1_6 := c1.w6, a1_7 := c1.w7,
    a2_0 := c2.w0, a2_1 := c2.w1, a2_2 := c2.w2, a2_3 := c2.w3, a2_4 := c2.w4, a2_5 := c2.w5, a2_6 := c2.w6, a2_7 := c2.w7,
    a3_0 := c3.w0, a3_1 := c3.w1, a3_2 := c3.w2, a3_3 := c3.w3, a3_4 := c3.w4, a3_5 := c3.w5, a3_6 := c3.w6, a3_7 := c3.w7,
    a4_0 := c4.w0, a4_1 := c4.w1, a4_2 := c4.w2, a4_3 := c4.w3, a4_4 := c4.w4, a4_5 := c4.w5, a4_6 := c4.w6, a4_7 := c4.w7 }

