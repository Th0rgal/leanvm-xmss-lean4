    let v4_2 := buf[b + 30]; let v5_2 := buf[b + 37]; let v6_2 := buf[b + 44]; let v7_2 := buf[b + 51]
    let v0_3 := buf[b + 3];  let v1_3 := buf[b + 10]; let v2_3 := buf[b + 17]; let v3_3 := buf[b + 24]
    let v4_3 := buf[b + 31]; let v5_3 := buf[b + 38]; let v6_3 := buf[b + 45]; let v7_3 := buf[b + 52]
    let ws := { ws with
      r0 := xorRow5FromCols ws.r0
        v0_1.w1 v1_1.w1 v2_1.w1 v3_1.w1 v4_1.w1 v5_1.w1 v6_1.w1 v7_1.w1
        v0_1.w2 v1_1.w2 v2_1.w2 v3_1.w2 v4_1.w2 v5_1.w2 v6_1.w2 v7_1.w2
        v0_1.w3 v1_1.w3 v2_1.w3 v3_1.w3 v4_1.w3 v5_1.w3 v6_1.w3 v7_1.w3
        v0_1.w4 v1_1.w4 v2_1.w4 v3_1.w4 v4_1.w4 v5_1.w4 v6_1.w4 v7_1.w4
        v0_1.w5 v1_1.w5 v2_1.w5 v3_1.w5 v4_1.w5 v5_1.w5 v6_1.w5 v7_1.w5,
