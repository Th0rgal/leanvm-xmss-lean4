        0 0 0 0 0 0 0 0 }
    let ws := permuteWs8 ws
    let v0_4 := buf[b + 4];  let v1_4 := buf[b + 11]; let v2_4 := buf[b + 18]; let v3_4 := buf[b + 25]
    let v4_4 := buf[b + 32]; let v5_4 := buf[b + 39]; let v6_4 := buf[b + 46]; let v7_4 := buf[b + 53]
    let v0_5 := buf[b + 5];  let v1_5 := buf[b + 12]; let v2_5 := buf[b + 19]; let v3_5 := buf[b + 26]
    let v4_5 := buf[b + 33]; let v5_5 := buf[b + 40]; let v6_5 := buf[b + 47]; let v7_5 := buf[b + 54]
