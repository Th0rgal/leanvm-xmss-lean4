@[inline] def loadStateIntoWs (st : State25x8) (ws : KeccakWs8) : KeccakWs8 :=
  { ws with
    r0 := copyRow5Into st.r0 ws.r0,
    r1 := copyRow5Into st.r1 ws.r1,
    r2 := copyRow5Into st.r2 ws.r2,
    r3 := copyRow5Into st.r3 ws.r3,
    r4 := copyRow5Into st.r4 ws.r4 }

@[inline] def zeroWs8 (ws : KeccakWs8) : KeccakWs8 :=
  let z : Vec8 := default
  { ws with
    r0 := mkRow5FromVecs z z z z z ws.r0,
    r1 := mkRow5FromVecs z z z z z ws.r1,
    r2 := mkRow5FromVecs z z z z z ws.r2,
    r3 := mkRow5FromVecs z z z z z ws.r3,
    r4 := mkRow5FromVecs z z z z z ws.r4 }

@[inline] def bcastState25 (s : State25) : State25x8 :=
  let z := mkFreshRow5x8 0
  ⟨mkRow5FromVecs (Vec8.bcast s.a00) (Vec8.bcast s.a01) (Vec8.bcast s.a02) (Vec8.bcast s.a03) (Vec8.bcast s.a04) z,
   mkRow5FromVecs (Vec8.bcast s.a05) (Vec8.bcast s.a06) (Vec8.bcast s.a07) (Vec8.bcast s.a08) (Vec8.bcast s.a09) z,
   mkRow5FromVecs (Vec8.bcast s.a10) (Vec8.bcast s.a11) (Vec8.bcast s.a12) (Vec8.bcast s.a13) (Vec8.bcast s.a14) z,
   mkRow5FromVecs (Vec8.bcast s.a15) (Vec8.bcast s.a16) (Vec8.bcast s.a17) (Vec8.bcast s.a18) (Vec8.bcast s.a19) z,
