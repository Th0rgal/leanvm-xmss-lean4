@@ -0,0 +1,145 @@
+import json
+import os
+import random
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+MASK = (1 << 64) - 1
+
+
+def kmul(a, b):
+    result = 0
+    for _ in range(64):
+        if b & 1:
+            result ^= a
+        a = ((a << 1) ^ (0x1b if a >> 63 else 0)) & MASK
+        b >>= 1
+    return result
+
+
+def emul(a, b):
+    result = [0] * 5
+    for i in range(3):
+        for j in range(3):
+            result[i + j] ^= kmul(a[i], b[j])
+    for j in (4, 3):
+        result[j - 3] ^= result[j]
+        result[j - 2] ^= result[j]
+    return result[:3]
+
+
+class BuildExeP0(unittest.TestCase):
+    def test_standalone_io_native_kernels_and_boxing(self):
+        with tempfile.TemporaryDirectory(prefix="build-exe-p0-") as tmp:
+            out = Path(os.environ.get("TURBO_P0_EVIDENCE_DIR", tmp)).resolve()
+            out.mkdir(parents=True, exist_ok=True)
+            exe = out / "field-io"
+            records = []
+
+            def run(args, expect=0, **kwargs):
