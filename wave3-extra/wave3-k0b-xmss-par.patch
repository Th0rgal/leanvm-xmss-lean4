+def signerDirectBytes (raw : @& RawSignature) (rawIdxVal : Spec.Field.E) (out : ByteArray) :
+    Except String ByteArray :=
+  if hpk : raw.publicKey.size = 32 then
+    if hmsg : raw.message.size = 32 then
