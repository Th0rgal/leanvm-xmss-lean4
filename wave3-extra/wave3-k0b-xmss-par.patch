+          omega
+        permuteAbsorb25 s
+          (readWordLEProof b base (by omega))
+          (readWordLEProof b (base + 8) (by omega))
+          (readWordLEProof b (base + 16) (by omega))
+          (readWordLEProof b (base + 24) (by omega))
+          (readWordLEProof b (base + 32) (by omega))
