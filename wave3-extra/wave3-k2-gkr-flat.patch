+import Model.KeccakGkr.Native
+import Model.Bus.Flat
+
+namespace LeanVmXmss.Model.KeccakGkr
+
+open Spec.Field (K E zero one)
+open Spec.Bus (SlotClaim OutputClaim)
+open Spec.KeccakGkr (Openings RingSwitchClaim)
+open Model.Bus (ProverState proveBusAndConstraintsFlat)
+
+def proveReductionFlat (state : ProverState) (committed : Array K) (executed : Nat)
+    (output : OutputClaim) : Openings × ProverState :=
+  proveReduction state committed executed output
+
+def proveKeccakGkrFlat (program : Array Spec.Vm.Op) (iv : ByteArray) (publicInput : Array E)
+    (bundle : Spec.Witness.WitnessBundle) : KeccakGkrStageOutput :=
+  let bus := proveBusAndConstraintsFlat program iv publicInput bundle
+  let qBase := (bundle.sized.layout.placements[Spec.Layout.qKeccak]?.join).map
+    Spec.Layout.Placement.index |>.getD 0
+  let executed := bundle.sized.rows[Spec.Layout.opKeccak]?.getD 0
+  let width := 1 <<< Spec.KeccakGkr.stepsLog executed
+  let span := (1 <<< Spec.KeccakGkr.slotBits) * width
+  let committed := (Array.range span).map fun index => bundle.message[qBase + index]?.getD 0
+  let reduced := proveReductionFlat bus.ps committed executed bus.keccakOutput
+  let extra :=
+    match reduced.1.outputs with
+    | none => #[]
+    | some opening => #[⟨qBase, opening.point, opening.value⟩]
+  ⟨reduced.2, bus.slotClaims ++ extra,
+    ⟨qBase, reduced.1.inputs.point, reduced.1.inputs.slices⟩, reduced.1⟩
+
+end LeanVmXmss.Model.KeccakGkr
