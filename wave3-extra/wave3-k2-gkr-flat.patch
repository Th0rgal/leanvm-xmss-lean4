+
+@[inline] def kmul6 (a b : E) : E :=
+  let v0 := nativeMul a.c0 b.c0
+  let v1 := nativeMul a.c1 b.c1
+  let v2 := nativeMul a.c2 b.c2
+  let t01 := nativeMul (a.c0 ^^^ a.c1) (b.c0 ^^^ b.c1) ^^^ v0 ^^^ v1
+  let t12 := nativeMul (a.c1 ^^^ a.c2) (b.c1 ^^^ b.c2) ^^^ v1 ^^^ v2
+  let t02 := nativeMul (a.c0 ^^^ a.c2) (b.c0 ^^^ b.c2) ^^^ v0 ^^^ v2
+  ⟨v0 ^^^ t12, t01 ^^^ t12 ^^^ v2, t02 ^^^ v1 ^^^ v2⟩
+
