+@[inline] def b47ToArray (b : B47) : Array E :=
+  #[b.e00, b.e01, b.e02, b.e03, b.e04, b.e05, b.e06, b.e07, b.e08, b.e09,
+    b.e10, b.e11, b.e12, b.e13, b.e14, b.e15, b.e16, b.e17, b.e18, b.e19,
+    b.e20, b.e21, b.e22, b.e23, b.e24, b.e25, b.e26, b.e27, b.e28, b.e29,
+    b.e30, b.e31, b.e32, b.e33, b.e34, b.e35, b.e36, b.e37, b.e38, b.e39,
+    b.e40, b.e41, b.e42, b.e43, b.e44, b.e45, b.e46]
